# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Local Postgres from docker-compose. Inside compose the host is "db" (set in docker-compose.yml).
DATABASE_URL=postgres://bartoszup:bartoszup@localhost:5432/bartoszup

SITE_URL=http://localhost:8000

# Email: console backend prints emails to the terminal. With docker compose,
# Mailpit catches all mail at http://localhost:8025 (EMAIL_URL is set in docker-compose.yml).
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=BartoszUP <no-reply@bartoszup.local>

# "mandatory" in production; dev settings default to "optional".
ACCOUNT_EMAIL_VERIFICATION=optional

# Google login (optional locally). Create an OAuth client in Google Cloud Console,
# redirect URI: http://localhost:8000/konto/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LISTING_DEFAULT_LIFETIME_DAYS=60

# Admin path. Defaults to "admin/" outside production; production refuses "admin/".
DJANGO_ADMIN_URL=admin/

# Cloudflare Turnstile for guest contact forms. Without keys guests must log in.
# Cloudflare test keys that always pass (dev only):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Reverse proxies appending to X-Forwarded-For (0 locally, 1 on Render).
TRUSTED_PROXY_COUNT=0
